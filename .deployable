# Laravel Cloud Deployment Configuration

# Path to your app's web directory
public_path=frontend/public

# Path to the environment file Laravel Cloud writes
env_file=frontend/.env

# List of directories that need to exist and be writable
directories_to_create="
  frontend/storage/logs
  frontend/storage/framework/cache
  frontend/storage/framework/cache/data
  frontend/storage/framework/sessions
  frontend/storage/framework/views
  frontend/storage/app/public
  frontend/storage/app/private
  frontend/storage/app/private/chat-media
  frontend/storage/app/private/chat-uploads
  frontend/bootstrap/cache
  frontend/database
"

# Shell commands to run during deployment
shell_commands="
  cd frontend
  php scripts/prepare-cloud-deployment.php
  composer install --no-dev --optimize-autoloader --no-interaction
  php artisan migrate --force --no-interaction
  php artisan storage:link || true
  php artisan optimize:clear
  php artisan config:cache
  php artisan view:cache
"
